# ==============================================================================
# EVENT-DRIVEN NOTIFICATION & AUDIT PIPELINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Managed Database)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string (URI / Parameters)
# Default port is 5432 (or 6543 if using connection pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_password_here
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ------------------------------------------------------------------------------
# 2. UPSTASH (Managed Serverless Redis with TLS)
# ------------------------------------------------------------------------------
# In Upstash: Redis -> Select Database -> Details
# Copy Endpoint hostname (without rediss://) and password
REDIS_HOST=<YOUR_UPSTASH_ENDPOINT>.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password_here
REDIS_SSL=true

# ------------------------------------------------------------------------------
# 3. AIVEN (Managed Apache Kafka with SASL_SSL)
# ------------------------------------------------------------------------------
# From your Aiven Kafka Overview tab (kafka-3f0281b9):
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka-3f0281b9-kuldeepkumar0122002-8dd3.a.aivencloud.com:17847
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="your_aiven_password_here";

# If Aiven requires CA Certificate validation, download 'ca.pem' from Aiven and set:
# KAFKA_SSL_TRUSTSTORE_TYPE=PEM
# KAFKA_SSL_TRUSTSTORE_LOCATION=C:/Users/91986/.gemini/antigravity/scratch/event-pipeline/ca.pem

# ------------------------------------------------------------------------------
# 4. BACKEND & FRONTEND SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=8080
VITE_API_BASE_URL=http://localhost:8080
